# Planning and tooling artifacts stay local. This repository is the deliverable,
# not the process that produced it. Anything here that earns publication gets
# added deliberately with `git add -f`, never by accident.
_bmad/
_bmad-output/
.memlog.md
.claude/
docs/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Models and data caches (never commit weights)
models/
.cache/
*.onnx
*.safetensors
*.bin

# Results are committed deliberately, scratch output is not
out/
scratch/

# The per-item trace is one object per corpus row and its consumer is a person debugging one
# document, not a reader recomputing the table. What the table needs is the per-stage edit counts,
# which are Count cells inside results/results.json. The README says how to regenerate this.
results/traces.jsonl

# OS / editor
.DS_Store
*.swp
